# ─────────────────────────────────────────
# TrueCheck Backend — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# Gemini API Key (FREE - get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Port (Render.com sets this automatically)
PORT=3001

# Allowed frontend origin (your Vercel URL or * for dev)
ALLOWED_ORIGIN=*

# Cache duration in seconds (how long to cache a product analysis)
CACHE_TTL=3600
